# Keep this local file outside Git after copying it to .env.
EDGECRAFT_ROOT=${PWD}
DATA_ROOT=${EDGECRAFT_ROOT}/data
OUTPUT_DIR=${EDGECRAFT_ROOT}/outputs

# Controller: select GPUs reserved for this service.
EDGECRAFT_GPU_IDS=0
EDGECRAFT_GPU_VRAM_GB=24
EDGECRAFT_PROFILE=paper

# Explicit device connection; see docs/devices.md.
DEVICE_HOST=user@device-host
SSH_KEY_PATH=/path/to/private_key
EDGE_DOCKER_IMAGE=edgecraft-runtime:desktop
# EDGECRAFT_DEVICE_MANIFEST=/path/to/local-devices.json

# Choose an OpenAI-compatible provider and model you have access to.
EDGECRAFT_LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_BASE=
OPENAI_MODEL=your-model-id
EDGECRAFT_LLM_MAX_OUTPUT_TOKENS=8000
# EDGECRAFT_DISABLE_LLM=1

# Runtime-created state and per-run token records.
EDGECRAFT_VERIFIER_CALIBRATION_PATH=${OUTPUT_DIR}/calibration.sqlite3
EDGECRAFT_COMPAT_RULE_STORE_PATH=${OUTPUT_DIR}/compatibility.sqlite3
EDGECRAFT_TOKEN_TELEMETRY_PATH=${OUTPUT_DIR}/tokens.jsonl
EDGECRAFT_REQUIRE_TOKEN_TELEMETRY=1

# Optional authenticated multi-tenant API; use locally generated random tokens.
# EDGECRAFT_API_TENANT_TOKENS='{"replace-with-a-random-token":"tenant-a"}'
# EDGECRAFT_TENANT_DATA_ROOT=/path/to/tenant-data
# EDGECRAFT_TENANT_CREDENTIAL_ROOT=/path/to/tenant-credentials
