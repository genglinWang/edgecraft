FROM python:3.11-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgomp1 libglib2.0-0 libgl1 libsndfile1 \
    && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir \
    torch==2.9.1 torchvision==0.24.1 torchaudio==2.9.1 \
    --index-url https://download.pytorch.org/whl/cpu
RUN python -m pip install --no-cache-dir numpy==1.26.4 \
    onnx==1.20.1 onnxruntime==1.24.3 ai-edge-litert==2.1.5 \
    transformers==4.57.6 timm==1.0.25 ultralytics==8.4.22 \
    pandas scipy scikit-learn soundfile pyyaml psutil
COPY check_runtime.py /opt/edgecraft/check_runtime.py
WORKDIR /workspace
