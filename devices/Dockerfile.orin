ARG BASE_IMAGE=dustynv/pytorch:2.7-r36.4.0
FROM ${BASE_IMAGE}
# Keep the JetPack-specific PyTorch/CUDA stack supplied by the base image.
RUN python3 -c "from importlib.metadata import distributions; print('\n'.join(d.metadata['Name'] + '==' + d.version for d in distributions() if d.metadata['Name'].lower() in {'torch', 'torchvision', 'torchaudio'}))" > /tmp/torch-constraints.txt
RUN PIP_CONFIG_FILE=/dev/null PIP_EXTRA_INDEX_URL= PIP_VERBOSE=0 python3 -m pip install \
    --index-url https://pypi.org/simple --timeout 30 --no-cache-dir -c /tmp/torch-constraints.txt numpy==1.26.4 \
    onnx==1.17.0 onnxruntime==1.23.2 transformers==4.57.6 \
    timm==1.0.25 ultralytics==8.4.22 soundfile pyyaml psutil
COPY check_runtime.py /opt/edgecraft/check_runtime.py
WORKDIR /workspace
