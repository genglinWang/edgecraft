#!/usr/bin/env bash
set -euo pipefail

# EdgeCraft Edge cleanup script (non-interactive, no dry-run).
# Intended to run from systemd timer every day at early morning.

CONFIG_FILE="/etc/edgecraft-edge-runner.env"
if [[ -f "$CONFIG_FILE" ]]; then
  # shellcheck disable=SC1090
  source "$CONFIG_FILE"
fi

BASE_DIR="${BASE_DIR:-/var/lib/edgecraft-edge-runner}"
KEEP_RECENT_OUTBOX="${CLEANUP_KEEP_RECENT_OUTBOX:-5}"
AGE_MINUTES="${CLEANUP_AGE_MINUTES:-1440}"

OUTBOX="$BASE_DIR/outbox"
INBOX="$BASE_DIR/inbox"
WORK="$BASE_DIR/work"
DONE="$BASE_DIR/done"
FAILED="$BASE_DIR/failed"
TMP="$BASE_DIR/tmp"

log() { echo "[edge-cleanup] $*"; }

ensure_dirs() {
  mkdir -p "$OUTBOX" "$INBOX" "$WORK" "$DONE" "$FAILED" "$TMP"
}

main() {
  ensure_dirs
  log "start base=$BASE_DIR keep_recent_outbox=$KEEP_RECENT_OUTBOX age_minutes=$AGE_MINUTES"

  # 1) Remove stale temp bundles.
  rm -f "$TMP"/edgecraft_*.tar.gz >/dev/null 2>&1 || true

  # 2) Keep only newest N tarballs in outbox.
  ls -1t "$OUTBOX"/edgecraft_*.tar.gz 2>/dev/null | awk "NR>${KEEP_RECENT_OUTBOX}" | xargs -r rm -f >/dev/null 2>&1 || true

  # 3) Remove old extracted result directories in outbox.
  find "$OUTBOX" -maxdepth 1 -type d \( -name 'edgecraft_profile_*' -o -name 'edgecraft_deploy_*' -o -name 'edgecraft_*' \) -mmin +"$AGE_MINUTES" -exec rm -rf {} + >/dev/null 2>&1 || true

  # 4) Remove old inbox tarballs that were never claimed.
  find "$INBOX" -maxdepth 1 -type f -name 'edgecraft_*.tar.gz' -mmin +"$AGE_MINUTES" -delete >/dev/null 2>&1 || true

  # 5) Remove old historical work/done/failed folders.
  find "$WORK" "$DONE" "$FAILED" -maxdepth 1 -type d -name 'edgecraft_*' -mmin +"$AGE_MINUTES" -exec rm -rf {} + >/dev/null 2>&1 || true

  log "done"
}

main "$@"
